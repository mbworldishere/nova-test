# NOVA EDGE Admin Panel Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development

# Session Secret (Change this in production!)
SESSION_SECRET=nova-edge-super-secret-key-change-in-production

# Database (Optional - for future expansion)
# DATABASE_URL=mongodb://localhost:27017/nova-edge

# File Upload Configuration
MAX_FILE_SIZE=52428800  # 50MB
UPLOAD_PATH=./admin/uploads

# Security
# Set to true in production with HTTPS
SECURE_COOKIES=false
